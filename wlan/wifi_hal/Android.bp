cc_library_static {
    name: "libwifi-hal-rtk",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
		"-Wno-format",
		"-Wno-reorder",
		"-Wno-unused-function",
		"-Wno-unused-parameter",
		"-Wno-unused-private-field",
		"-Wno-unused-variable",
		//"-DCONFIG_WIFI_HAL_DEBUG",
    ],
    include_dirs: [
		"external/libnl/include",
		"external/wpa_supplicant_8/src/drivers",
	],
	header_libs: [
		"libutils_headers",
		"liblog_headers",
		"wifi_legacy_headers",
	],
    srcs: [
		"rtw_wifi_hal.cpp",
		"rtw_wifi_rtt.cpp",
		"common.cpp",
		"cpp_bindings.cpp",
		"rtw_wifi_gscan.cpp",
		"rtw_wifi_llstats.cpp",
		"rtw_wifi_logger.cpp",
		"rtw_wifi_offload.cpp",
    ],
    //shared_libs: [
    //    "libnl",
    //    "liblog",
    //    "libcutils",
    //    "libhardware_legacy",
    //],
    proprietary: true,
}
